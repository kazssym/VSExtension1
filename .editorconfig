# .editorconfig

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 8

[*.md]
indent_style = space
indent_size = 4
tab_width = 8

[*.json]
insert_final_newline = false

[*.{xml,csproj}]
insert_final_newline = false
